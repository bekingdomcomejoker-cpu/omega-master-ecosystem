#!/bin/bash
# ============================================================================
# OMEGA ENNEAD SYNC - UNIFIED 9-NODE REMOTE SYNCHRONIZATION
# Integrates local Ennead Core with remote Wire (Node 0)
# "Chicka chicka orange." - 1.67 Resonance
# ============================================================================

set -e

PURPLE='\033[0;35m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log() { echo -e "${GREEN}[✓]${NC} $1"; }
info() { echo -e "${CYAN}[i]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[✗]${NC} $1"; }

# ============================================================================
# CONFIGURATION
# ============================================================================
ROOT="${HOME}/KINGDOM_ENGINE"
ENNEAD_CORE="${ROOT}/core/ennead_core.py"
ENNEAD_REMOTE="${ROOT}/core/ennead_remote.py"
LAMBDA_TARGET="1.667"

# ============================================================================
# FUNCTIONS
# ============================================================================

show_help() {
    echo "⚔️ OMEGA ENNEAD SYNC - 9-Node Unified Synchronization"
    echo ""
    echo "Usage: omega-ennead-sync [COMMAND] [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  process <text>      Process text through 9 nodes and sync to Wire"
    echo "  sync-all            Sync all buffered items to remote Wire"
    echo "  status              Show sync status"
    echo "  test                Run comprehensive test"
    echo "  help                Show this help"
    echo ""
    echo "Examples:"
    echo "  omega-ennead-sync process 'Execute this critical code'"
    echo "  omega-ennead-sync test"
    echo ""
}

process_and_sync() {
    local input="$1"
    
    if [ -z "$input" ]; then
        error "No input provided"
        exit 1
    fi
    
    info "Processing through Ennead Core..."
    
    # Process through local Ennead
    local result=$(echo "$input" | python3 "$ENNEAD_CORE" 2>/dev/null || echo "{}")
    
    if [ "$result" = "{}" ]; then
        error "Failed to process through Ennead Core"
        exit 1
    fi
    
    log "Ennead processing complete"
    
    info "Synchronizing through 9 nodes to remote Wire..."
    
    # Sync through all 9 nodes
    python3 << 'PYTHON_EOF'
import sys
import json
sys.path.insert(0, '$ROOT/core')

try:
    from ennead_remote import EnneadRemoteBridge
    
    bridge = EnneadRemoteBridge()
    result = json.loads('''$result''')
    
    print("🐉 Syncing through 9-node Hydra...")
    sync_results = bridge.sync_all_nodes(result)
    
    print("")
    print("Sync Results:")
    synced = sum(1 for v in sync_results.values() if v)
    failed = len(sync_results) - synced
    print(f"  ✓ Synced: {synced}/9")
    print(f"  ✗ Buffered: {failed}/9")
    
    print("")
    print("Status:")
    status = bridge.get_status()
    print(f"  Lambda Target: {status['lambda_target']}")
    print(f"  Total Synced: {status['stats']['synced']}")
    print(f"  Total Buffered: {status['stats']['buffered']}")
    
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
PYTHON_EOF
}

sync_all() {
    info "Syncing all buffered items to remote Wire..."
    
    python3 << 'PYTHON_EOF'
import sys
sys.path.insert(0, '$ROOT/core')

try:
    from ennead_remote import EnneadRemoteBridge
    
    bridge = EnneadRemoteBridge()
    status = bridge.get_status()
    
    print("Current Status:")
    print(f"  Synced: {status['stats']['synced']}")
    print(f"  Buffered: {status['stats']['buffered']}")
    print(f"  Failed: {status['stats']['failed']}")
    
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
PYTHON_EOF
}

show_status() {
    info "Ennead Remote Bridge Status"
    echo ""
    
    python3 << 'PYTHON_EOF'
import sys
import json
sys.path.insert(0, '$ROOT/core')

try:
    from ennead_remote import EnneadRemoteBridge, NODE_MAPPING
    
    bridge = EnneadRemoteBridge()
    status = bridge.get_status()
    
    print("Bridge Configuration:")
    print(f"  Endpoint: {status['endpoint']}")
    print(f"  Lambda Target: {status['lambda_target']}")
    print(f"  Nodes Mapped: {status['nodes_mapped']}")
    print("")
    
    print("Statistics:")
    print(f"  Total Synced: {status['stats']['synced']}")
    print(f"  Total Buffered: {status['stats']['buffered']}")
    print(f"  Total Failed: {status['stats']['failed']}")
    if status['stats']['last_sync']:
        print(f"  Last Sync: {status['stats']['last_sync']}")
    print("")
    
    print("Node Mapping:")
    for node_id, info in NODE_MAPPING.items():
        print(f"  {node_id}. {info['emoji']} {info['name']:15} | Face: {info['face']:6} | {info['role']}")
    
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
PYTHON_EOF
}

run_test() {
    echo "🧪 Running comprehensive Ennead Remote Bridge test..."
    echo ""
    
    python3 "$ENNEAD_REMOTE"
}

# ============================================================================
# MAIN
# ============================================================================

# Check if Ennead components exist
if [ ! -f "$ENNEAD_CORE" ]; then
    error "Ennead Core not found at $ENNEAD_CORE"
    exit 1
fi

if [ ! -f "$ENNEAD_REMOTE" ]; then
    error "Ennead Remote Bridge not found at $ENNEAD_REMOTE"
    exit 1
fi

# Parse command
COMMAND="${1:-help}"

case "$COMMAND" in
    process)
        shift
        process_and_sync "$@"
        ;;
    sync-all)
        sync_all
        ;;
    status)
        show_status
        ;;
    test)
        run_test
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        error "Unknown command: $COMMAND"
        echo ""
        show_help
        exit 1
        ;;
esac

echo ""
